<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- design container.permissions: CAMERA for SpatialML Readback (F2, asked at the first 拍), eye tracking (F7). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />
    <uses-permission android:name="com.picovr.permission.HAND_TRACKING" />
    <uses-permission android:name="com.picovr.permission.SPATIAL_DATA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RegionSnapTheme"
        tools:targetApi="31">

        <!-- SpatialML (the camera frame, Readback mode) needs the experimental API flag (F4). -->
        <meta-data
            android:name="pico.spatial.use_experimental_api"
            android:value="1" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.RegionSnapTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: design container STAGE_MIXED (Full Space, passthrough): eyes, hands, controllers, planes, anchors. -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="RegionSnapStage" />

            <!-- "1": StageStyle.Mixed: virtual content over the real room -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />

            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />

        </activity>
    </application>

</manifest>
